# Database
DATABASE_URL=sqlite:///./data/campaigns.db

# Research agent limits
MAX_TOOL_CALLS=8
MAX_FOLLOWUP_SEARCHES=2
PAGE_FETCH_TIMEOUT=10
RESEARCH_WALL_CLOCK=90
PAGE_TEXT_CAP=20000
LLM_RETRIES=1

# Worker polling
WORKER_POLL_INTERVAL=2
WORKER_HEARTBEAT_TIMEOUT=30

# Mock mode (set to 1 for mock mode)
MOCK_MODE=0

# Failure injection for testing
# FAIL_STAGE=research
# FAIL_ONCE=image_1x1

# Asset storage
ASSET_DIR=./data/campaigns

# API keys (server-side only, never commit actual values)
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here

# Upload limits
MAX_UPLOAD_SIZE=5
